# Copie este arquivo para ".env" e preencha com suas próprias credenciais.
# NUNCA commite o arquivo ".env" de verdade (ele já está no .gitignore).

# String de conexão do Postgres (Neon). Pegue a sua em https://neon.tech
DATABASE_URL="postgresql://usuario:senha@host/nome_do_banco?sslmode=require&channel_binding=require"

# Segredo usado para assinar os tokens JWT. Use uma string longa e aleatória.
JWT_SECRET="troque_por_um_segredo_forte"
